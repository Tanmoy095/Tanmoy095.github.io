---
const { entry, href, eyebrow = entry.data.category || entry.data.type } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60">
    {entry.data.coverImage && <a href={href} class="block aspect-[16/9] overflow-hidden"><img src={entry.data.coverImage} alt={entry.data.coverAlt || entry.data.title} class="h-full w-full object-cover" loading="lazy" /></a>}
    <div class="p-6">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">{eyebrow}</p>
        <h2 class="text-xl font-bold"><a href={href} class="hover:text-blue-700 dark:hover:text-blue-300">{entry.data.title}</a></h2>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{entry.data.description}</p>
        <div class="mt-4 flex flex-wrap gap-2">
            {entry.data.tags.map((tag: string) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">{tag}</span>)}
        </div>
        <time class="mt-5 block text-xs text-slate-500" datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    </div>
</article>
