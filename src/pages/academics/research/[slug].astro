---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
export async function getStaticPaths() {
  return (await getCollection('knowledge')).filter(entry => ['research', 'research-note'].includes(entry.data.type) && ['published', 'unlisted'].includes(entry.data.status)).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<MainLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description}>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': entry.data.type === 'research' ? 'ScholarlyArticle' : 'Article', headline: entry.data.title, description: entry.data.description, datePublished: entry.data.date.toISOString(), abstract: entry.data.abstract, image: entry.data.coverImage && new URL(entry.data.coverImage, Astro.site || 'https://tanmoy095.github.io').toString() }).replace(/</g, '\\u003c')} />
    <article class="mx-auto max-w-3xl">
        <a href="/academics/research/" class="text-sm font-semibold text-blue-700 dark:text-blue-300">← Research</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">{entry.data.category || 'Research'}{entry.data.status === 'unlisted' && <span class="ml-2 rounded-full bg-amber-100 px-2 py-1 text-amber-800">Unlisted</span>}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{entry.data.title}</h1>
        <p class="mt-5 text-xl leading-8 text-slate-600 dark:text-slate-300">{entry.data.description}</p>
        {entry.data.coverImage && <img class="mt-8 w-full rounded-3xl" src={entry.data.coverImage} alt={entry.data.coverAlt || entry.data.title} />}
        {entry.data.abstract && <section class="mt-8 rounded-2xl bg-slate-100 p-6 dark:bg-slate-900"><h2 class="font-bold">Abstract</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.abstract}</p></section>}
        {entry.data.researchQuestion && <section class="mt-8"><h2 class="text-xl font-bold">Research question</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.researchQuestion}</p></section>}
        {entry.data.objectives && <section class="mt-8"><h2 class="text-xl font-bold">Objectives</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.objectives}</p></section>}
        {entry.data.background && <section class="mt-8"><h2 class="text-xl font-bold">Background</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.background}</p></section>}
        {entry.data.literatureReview && <section class="mt-8"><h2 class="text-xl font-bold">Literature review</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.literatureReview}</p></section>}
        {entry.data.methodology && <section class="mt-8"><h2 class="text-xl font-bold">Methodology</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.methodology}</p></section>}
        {entry.data.materialsAndMethods && <section class="mt-8"><h2 class="text-xl font-bold">Materials and methods</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.materialsAndMethods}</p></section>}
        {entry.data.findings && <section class="mt-8"><h2 class="text-xl font-bold">Findings</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.findings}</p></section>}
        {entry.data.discussion && <section class="mt-8"><h2 class="text-xl font-bold">Discussion</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.discussion}</p></section>}
        {entry.data.conclusion && <section class="mt-8"><h2 class="text-xl font-bold">Conclusion</h2><p class="mt-2 whitespace-pre-line leading-7">{entry.data.conclusion}</p></section>}
        <div class="markdown-body mt-10"><Content /></div>
        {entry.data.references.length > 0 && <section class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-800"><h2 class="text-xl font-bold">References</h2><ol class="mt-3 list-decimal space-y-2 pl-6">{entry.data.references.map(ref => <li>{ref}</li>)}</ol></section>}
        {entry.data.documents.length > 0 && <section class="mt-8"><h2 class="text-xl font-bold">Documents</h2><ul class="mt-3 list-disc space-y-2 pl-6">{entry.data.documents.map(doc => <li><a class="text-blue-700 underline dark:text-blue-300" href={doc} rel="noopener">Download research document</a></li>)}</ul></section>}
    </article>
</MainLayout>
