---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import profile from '../../data/profile.json';
const all = await getCollection('knowledge');
const published = all.filter(entry => entry.data.status === 'published');
const profiles = published.filter(entry => entry.data.type === 'academic').sort((a, b) => a.data.order - b.data.order);
const research = published.filter(entry => ['research', 'research-note'].includes(entry.data.type)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<MainLayout title="Academics & Research" description="Academic background and research work by Aunmoy Dey Tanmoy.">
    <header class="mb-12 max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">Academics</p>
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">Study, research, and discovery</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">A separate space for academic work and research, alongside my engineering portfolio.</p>
    </header>
    <section class="mb-14 rounded-3xl border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900/60">
        <h2 class="text-2xl font-bold">Academic profile</h2>
        {profile.education.map(item => <div class="mt-5"><h3 class="font-semibold">{item.degree}</h3><p class="text-slate-600 dark:text-slate-300">{item.institution} · {item.status} {item.period}</p></div>)}
        {profiles.map(entry => <KnowledgeCard entry={entry} href={`/academics/${entry.id}/`} />)}
        <p class="mt-5 text-sm text-slate-500">Thesis details and additional qualifications appear here only after publication from the CMS.</p>
    </section>
    <section>
        <div class="mb-6 flex items-end justify-between"><div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">Research</p><h2 class="mt-2 text-3xl font-bold">Projects and notes</h2></div></div>
        {research.length ? <div class="grid gap-6 md:grid-cols-2">{research.map(entry => <KnowledgeCard entry={entry} href={`/academics/research/${entry.id}/`} />)}</div> : <p class="rounded-2xl border border-dashed border-slate-300 p-8 text-slate-500 dark:border-slate-700">Research entries will appear here when published.</p>}
        <a class="mt-6 inline-flex font-semibold text-blue-700 dark:text-blue-300" href="/academics/research/">Explore research →</a>
    </section>
</MainLayout>
