---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
export async function getStaticPaths() { return (await getCollection('knowledge')).filter(entry => entry.data.type === 'academic' && ['published', 'unlisted'].includes(entry.data.status)).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<MainLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description}>
    <article class="mx-auto max-w-3xl"><a href="/academics/" class="text-sm font-semibold text-blue-700 dark:text-blue-300">← Academics & Research</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">Academic profile{entry.data.status === 'unlisted' && <span class="ml-2 rounded-full bg-amber-100 px-2 py-1 text-amber-800">Unlisted</span>}</p>
        <h1 class="mt-3 text-4xl font-bold md:text-5xl">{entry.data.title}</h1><p class="mt-5 text-lg text-slate-600 dark:text-slate-300">{entry.data.description}</p>
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">{[['University', entry.data.university], ['Degree', entry.data.degree], ['Department', entry.data.department], ['Faculty', entry.data.faculty], ['Graduation year', entry.data.graduationYear], ['Start date', entry.data.startDate], ['End date', entry.data.endDate], ['Thesis', entry.data.thesisTitle]].filter(([, value]) => value).map(([label, value]) => <div class="rounded-xl bg-slate-100 p-4 dark:bg-slate-900"><dt class="text-xs font-semibold uppercase text-slate-500">{label}</dt><dd class="mt-1 font-medium">{value}</dd></div>)}</dl>
        {entry.data.academicInterests.length > 0 && <section class="mt-10"><h2 class="text-xl font-bold">Academic interests</h2><ul class="mt-3 flex flex-wrap gap-2">{entry.data.academicInterests.map(item => <li class="rounded-full bg-blue-50 px-3 py-1 text-sm text-blue-800 dark:bg-blue-950 dark:text-blue-200">{item}</li>)}</ul></section>}
        <div class="markdown-body mt-10"><Content /></div>
    </article>
</MainLayout>
