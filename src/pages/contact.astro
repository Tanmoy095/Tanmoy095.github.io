---
import MainLayout from '../layouts/MainLayout.astro';
import profile from '../data/profile.json';
---
<MainLayout title="Contact" description="Contact Aunmoy Dey Tanmoy about backend engineering and collaboration.">
    <section class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 dark:border-slate-800 dark:bg-slate-900/50 md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">Contact</p>
        <h1 class="mt-3 text-4xl font-bold">Start a conversation</h1>
        <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300">Email is the direct contact route. This website does not currently send contact-form submissions or claim message delivery.</p>
        <a href={`mailto:${profile.email}`} class="mt-7 inline-flex rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800">Email {profile.name}</a>
        <div class="mt-8 flex flex-wrap gap-4 text-sm"><a class="font-semibold text-blue-700 dark:text-blue-300" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a><a class="font-semibold text-blue-700 dark:text-blue-300" href={profile.github} target="_blank" rel="noreferrer">GitHub</a></div>
    </section>
</MainLayout>
