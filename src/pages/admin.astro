---
import MainLayout from '../layouts/MainLayout.astro';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || '';
---

<MainLayout title="Admin Dashboard - CMS Panel">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>
    <script is:inline define:vars={{ apiBaseUrl }}>
        const sameOriginApi = location.hostname === 'tanmoy095.github.io' ? '' : location.origin;
        window.__ADMIN_CONFIG__ = { apiBaseUrl: apiBaseUrl || sameOriginApi };
    </script>
    <script src="/admin-cms.js" defer></script>

    <div id="cms-toast" class="hidden fixed bottom-6 right-6 z-[100] opacity-0 transition-opacity"></div>

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="max-w-md mx-auto py-16">
        <div class="text-center mb-10">
            <div class="text-5xl mb-4">🔐</div>
            <h1 class="text-3xl font-extrabold tracking-tight mb-2">Admin Access</h1>
            <p id="login-hint" class="text-slate-500 text-sm">Enter your credentials to manage the portfolio.</p>
        </div>
        <form id="login-form" class="bg-white dark:bg-slate-900/40 border border-slate-200/50 dark:border-slate-800/50 p-8 rounded-3xl shadow-sm space-y-5">
            <div>
                <label for="login-email" class="label-heading">Admin Email</label>
                <input type="email" id="login-email" required class="form-input" placeholder="your@email.com" />
            </div>
            <div>
                <label for="login-password" class="label-heading">Password</label>
                <input type="password" id="login-password" required class="form-input" placeholder="••••••••" />
            </div>
            <button type="submit" id="login-submit" class="btn-primary w-full py-3 text-sm uppercase font-semibold tracking-wide">Unlock Dashboard</button>
        </form>
    </div>

    <!-- DASHBOARD -->
    <div id="dashboard-screen" class="hidden py-6">
        <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight">CMS <span class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">Dashboard</span></h1>
                <p id="mode-label" class="text-xs text-slate-500 mt-1"></p>
            </div>
            <div class="flex items-center gap-3">
                <div id="status-badge" class="px-4 py-2 rounded-xl text-xs font-semibold uppercase"></div>
                <button id="btn-logout" type="button" class="btn-secondary py-2 px-4 text-xs">Logout</button>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="p-4 bg-indigo-50/50 dark:bg-indigo-950/20 border border-indigo-100/30 rounded-2xl">
                <div id="stat-profile" class="text-lg font-bold text-indigo-600">—</div>
                <p class="text-[10px] uppercase font-semibold text-slate-500">Profile</p>
            </div>
            <div class="p-4 bg-purple-50/50 dark:bg-purple-950/20 border border-purple-100/30 rounded-2xl">
                <div id="stat-projects" class="text-lg font-bold text-purple-600">—</div>
                <p class="text-[10px] uppercase font-semibold text-slate-500">Projects</p>
            </div>
            <div class="p-4 bg-pink-50/50 dark:bg-pink-950/20 border border-pink-100/30 rounded-2xl">
                <div id="stat-blogs" class="text-lg font-bold text-pink-600">—</div>
                <p class="text-[10px] uppercase font-semibold text-slate-500">Blogs</p>
            </div>
            <div class="p-4 bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100/30 rounded-2xl">
                <div id="stat-learnings" class="text-lg font-bold text-blue-600">—</div>
                <p class="text-[10px] uppercase font-semibold text-slate-500">Learnings</p>
            </div>
        </div>

        <div class="mb-6">
            <button id="btn-reload-all" type="button" class="btn-secondary text-xs py-2 px-4">↻ Reload All Content from Git</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-3 flex flex-row lg:flex-col gap-2 overflow-x-auto lg:overflow-x-visible pb-4 lg:pb-0">
                <button class="nav-tab active" data-target="tab-profile">👤 About & Skills</button>
                <button class="nav-tab" data-target="tab-projects">📂 Projects</button>
                <button class="nav-tab" data-target="tab-blogs">✍️ Blogs</button>
                <button class="nav-tab" data-target="tab-learnings">📖 Learnings & ADRs</button>
                <button class="nav-tab" data-target="tab-knowledge">🌿 Academics & Life</button>
            </div>

            <div class="lg:col-span-9 bg-white dark:bg-slate-900/30 border border-slate-200/50 dark:border-slate-800/50 p-6 sm:p-8 rounded-3xl shadow-sm min-h-[500px]">

                <!-- PROFILE -->
                <div id="tab-profile" class="tab-panel space-y-6">
                    <h2 class="text-2xl font-bold border-b border-slate-100 dark:border-slate-800 pb-3">About Me & Homepage</h2>
                    <p id="profile-prompt" class="text-slate-400 text-sm hidden">Loading...</p>
                    <form id="profile-form" class="space-y-6">
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div><label class="label-heading">Full Name</label><input type="text" id="prof-name" required class="form-input" /></div>
                            <div><label class="label-heading">Professional Title</label><input type="text" id="prof-title" required class="form-input" /></div>
                        </div>
                        <div class="grid sm:grid-cols-3 gap-4">
                            <div><label class="label-heading">Email</label><input type="email" id="prof-email" required class="form-input" /></div>
                            <div><label class="label-heading">Phone</label><input type="text" id="prof-phone" class="form-input" /></div>
                            <div><label class="label-heading">Location</label><input type="text" id="prof-location" class="form-input" /></div>
                        </div>
                        <div class="grid sm:grid-cols-3 gap-4">
                            <div><label class="label-heading">GitHub</label><input type="url" id="prof-github" class="form-input" /></div>
                            <div><label class="label-heading">LinkedIn</label><input type="url" id="prof-linkedin" class="form-input" /></div>
                            <div><label class="label-heading">Twitter</label><input type="url" id="prof-twitter" class="form-input" /></div>
                        </div>
                        <!-- CV Management Section -->
                        <div class="p-5 bg-slate-50 dark:bg-slate-900/50 border border-slate-200/50 dark:border-slate-800/50 rounded-2xl space-y-4">
                            <div class="flex items-center justify-between flex-wrap gap-4">
                                <div class="flex items-center gap-3">
                                    <span class="text-2xl">📄</span>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-950 dark:text-slate-100" id="cv-status-title">Current CV</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400 font-mono" id="cv-status-path">/cv.pdf</div>
                                    </div>
                                </div>
                                <button type="button" id="btn-delete-cv" class="px-4 py-2 text-xs bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200/30 dark:border-rose-900/30 rounded-xl font-semibold transition active:scale-95">Delete CV</button>
                            </div>
                            <div class="grid sm:grid-cols-2 gap-4 items-end pt-2 border-t border-slate-200/30 dark:border-slate-800/30">
                                <div>
                                    <label class="label-heading">Upload / Reupload PDF</label>
                                    <input type="file" id="prof-cv-file" accept="application/pdf" class="form-input text-xs" />
                                </div>
                                <div>
                                    <label class="label-heading">CV URL Path</label>
                                    <input type="text" id="prof-cv-url" placeholder="/cv.pdf" class="form-input" />
                                </div>
                            </div>
                        </div>
                        <!-- Profile Photo Management Section -->
                        <div class="p-5 bg-slate-50 dark:bg-slate-900/50 border border-slate-200/50 dark:border-slate-800/50 rounded-2xl space-y-4">
                            <div class="flex items-center justify-between flex-wrap gap-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-950 border border-slate-200/50 dark:border-slate-800 flex items-center justify-center text-xl">
                                        <img id="prof-avatar-preview" class="hidden w-full h-full object-cover" alt="Avatar Preview" />
                                        <span id="prof-avatar-placeholder">👤</span>
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-950 dark:text-slate-100" id="avatar-status-title">Profile Photo</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400 font-mono" id="avatar-status-path">No photo uploaded</div>
                                    </div>
                                </div>
                                <button type="button" id="btn-delete-avatar" class="px-4 py-2 text-xs bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200/30 dark:border-rose-900/30 rounded-xl font-semibold transition active:scale-95">Delete Photo</button>
                            </div>
                            <div class="grid sm:grid-cols-2 gap-4 items-end pt-2 border-t border-slate-200/30 dark:border-slate-800/30">
                                <div>
                                    <label class="label-heading">Upload / Reupload Photo</label>
                                    <input type="file" id="prof-avatar-file" accept="image/*" class="form-input text-xs" />
                                </div>
                                <div>
                                    <label class="label-heading">Photo URL Path</label>
                                    <input type="text" id="prof-avatar-url" placeholder="/profile-assets/avatar.jpg" class="form-input" />
                                </div>
                            </div>
                        </div>
                        <div><label class="label-heading">Homepage Summary</label><textarea id="prof-summary" rows="3" class="form-input"></textarea></div>
                        <div><label class="label-heading">About Page — Detailed Summary</label><textarea id="prof-detailedSummary" rows="4" class="form-input"></textarea></div>
                        <div><label class="label-heading">Career Objective</label><textarea id="prof-objective" rows="3" class="form-input"></textarea></div>
                        <div><label class="label-heading">Recruiter Summary</label><textarea id="prof-recruiter" rows="3" class="form-input"></textarea></div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="label-heading mb-0">Target Roles</label>
                                <button type="button" id="btn-add-role" class="text-xs text-indigo-600 font-semibold">+ Add Role</button>
                            </div>
                            <div id="roles-editor"></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="label-heading mb-0">Skills & Categories</label>
                                <button type="button" id="btn-add-skill-cat" class="text-xs text-indigo-600 font-semibold">+ Add Category</button>
                            </div>
                            <div id="skills-editor" class="space-y-4"></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="label-heading mb-0">Experience Highlights</label>
                                <button type="button" id="btn-add-highlight" class="text-xs text-indigo-600 font-semibold">+ Add Highlight</button>
                            </div>
                            <div id="highlights-editor" class="space-y-4"></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="label-heading mb-0">Education</label>
                                <button type="button" id="btn-add-education" class="text-xs text-indigo-600 font-semibold">+ Add Education</button>
                            </div>
                            <div id="education-editor" class="space-y-4"></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="label-heading mb-0">Work History</label>
                                <button type="button" id="btn-add-history" class="text-xs text-indigo-600 font-semibold">+ Add Job</button>
                            </div>
                            <div id="history-editor" class="space-y-4"></div>
                        </div>

                        <button type="submit" class="btn-primary w-full py-3 text-sm uppercase font-semibold">Publish About & Profile Live</button>
                    </form>
                </div>
                <!-- SHARED KNOWLEDGE PUBLISHING -->
                <div id="tab-knowledge" class="tab-panel hidden space-y-6">
                    <div class="flex flex-col gap-4 border-b pb-4 sm:flex-row sm:items-end sm:justify-between">
                        <div><h2 class="text-2xl font-bold">Academics, Research & Personal Knowledge</h2><p class="mt-2 max-w-2xl text-sm text-slate-500">One editor for research, essays, personal stories, travel, books, quotes and reflections. Draft/private entries are omitted from the public build; unlisted entries work by direct URL only.</p></div>
                        <button id="btn-create-knowledge" type="button" class="btn-primary shrink-0 px-4 py-2 text-xs">+ New Entry</button>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-3">
                        <input id="knowledge-search" class="form-input" type="search" placeholder="Search entries" aria-label="Search knowledge entries" />
                        <select id="knowledge-type-filter" class="form-input" aria-label="Filter by content type"><option value="all">All modules</option><option value="academic">Academic profile</option><option value="research">Research project</option><option value="research-note">Research note</option><option value="essay">Essay</option><option value="personal-story">Personal story</option><option value="travel">Travel</option><option value="book">Book notes</option><option value="quote">Quote</option><option value="reflection">Reflection</option></select>
                        <select id="knowledge-status-filter" class="form-input" aria-label="Filter by publication status"><option value="all">All visibility</option><option value="draft">Draft</option><option value="published">Published</option><option value="unlisted">Unlisted</option><option value="private">Private</option></select>
                    </div>
                    <div id="knowledge-list" class="grid gap-4 md:grid-cols-2"></div>
                    <p id="knowledge-prompt" class="py-8 text-center text-sm text-slate-500">Loading entries…</p>
                    <form id="knowledge-form" class="hidden space-y-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950 sm:p-7">
                        <div class="flex flex-wrap items-center justify-between gap-3"><h3 id="knowledge-form-title" class="text-xl font-bold">New knowledge entry</h3><button id="knowledge-cancel" type="button" class="btn-secondary px-4 py-2 text-xs">Close</button></div>
                        <input id="knowledge-sha" type="hidden" /><input id="knowledge-path" type="hidden" />
                        <div class="grid gap-4 sm:grid-cols-3">
                            <div><label for="knowledge-slug" class="label-heading">Slug</label><input id="knowledge-slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" class="form-input" placeholder="cfrp-milling-study" /></div>
                            <div><label for="knowledge-type" class="label-heading">Module</label><select id="knowledge-type" class="form-input"><option value="academic">Academic profile</option><option value="research">Research project</option><option value="research-note">Research note</option><option value="essay">Essay</option><option value="personal-story">Personal story</option><option value="travel">Travel story</option><option value="book">Book notes</option><option value="quote">Quote</option><option value="reflection">Reflection</option></select></div>
                            <div><label for="knowledge-status" class="label-heading">Visibility</label><select id="knowledge-status" class="form-input"><option value="draft">Draft</option><option value="published">Published</option><option value="unlisted">Unlisted (direct URL only)</option><option value="private">Private (Redis protected)</option></select></div>
                        </div>
                        <div><label for="knowledge-title" class="label-heading">Title</label><input id="knowledge-title" required class="form-input" /></div>
                        <div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-description" class="label-heading">Summary / abstract</label><textarea id="knowledge-description" rows="3" class="form-input"></textarea></div><div><label for="knowledge-category" class="label-heading">Category</label><input id="knowledge-category" class="form-input" placeholder="Create or select a category by entering its name" /></div></div>
                        <div class="grid gap-4 sm:grid-cols-3"><div><label for="knowledge-tags" class="label-heading">Tags (comma separated)</label><input id="knowledge-tags" class="form-input" /></div><div><label for="knowledge-date" class="label-heading">Publication / note date</label><input id="knowledge-date" type="date" class="form-input" /></div><div><label for="knowledge-order" class="label-heading">Order</label><input id="knowledge-order" type="number" value="0" class="form-input" /></div></div>
                        <label class="flex items-center gap-2 text-sm font-semibold"><input id="knowledge-featured" type="checkbox" class="rounded" /> Featured on its section</label>
                        <div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-seo-title" class="label-heading">SEO title</label><input id="knowledge-seo-title" class="form-input" /></div><div><label for="knowledge-seo-description" class="label-heading">SEO description</label><input id="knowledge-seo-description" class="form-input" /></div></div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div><label for="knowledge-cover" class="label-heading">Cover image URL</label><input id="knowledge-cover" class="form-input" /></div>
                            <div><label for="knowledge-cover-file" class="label-heading">Upload cover image (EXIF/GPS stripped)</label><input id="knowledge-cover-file" type="file" accept="image/jpeg,image/png,image/webp" class="form-input" /></div>
                        </div>
                        <div><label for="knowledge-cover-alt" class="label-heading">Cover image alt text / caption</label><input id="knowledge-cover-alt" class="form-input" /></div>
                        <div id="knowledge-travel-fields" class="knowledge-fields hidden space-y-4 rounded-xl border p-4" data-types="travel"><h4 class="font-bold">Travel story</h4><div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-country" class="label-heading">Country</label><input id="knowledge-country" class="form-input" /></div><div><label for="knowledge-location" class="label-heading">Location</label><input id="knowledge-location" class="form-input" /></div><div><label for="knowledge-travel-start" class="label-heading">Travel start</label><input id="knowledge-travel-start" type="date" class="form-input" /></div><div><label for="knowledge-travel-end" class="label-heading">Travel end</label><input id="knowledge-travel-end" type="date" class="form-input" /></div></div><div><label for="knowledge-places" class="label-heading">Places visited (one per line)</label><textarea id="knowledge-places" rows="2" class="form-input"></textarea></div><div><label for="knowledge-gallery" class="label-heading">Gallery image URLs (one per line)</label><textarea id="knowledge-gallery" rows="3" class="form-input"></textarea></div><div><label for="knowledge-gallery-captions" class="label-heading">Gallery captions (one per line, matching image order)</label><textarea id="knowledge-gallery-captions" rows="3" class="form-input"></textarea></div><div><label for="knowledge-gallery-files" class="label-heading">Upload gallery photos (EXIF/GPS stripped)</label><input id="knowledge-gallery-files" type="file" accept="image/jpeg,image/png,image/webp" multiple class="form-input" /></div></div>
                        <div id="knowledge-academic-fields" class="knowledge-fields hidden space-y-4 rounded-xl border p-4" data-types="academic"><h4 class="font-bold">Academic profile</h4><div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-university" class="label-heading">University</label><input id="knowledge-university" class="form-input" /></div><div><label for="knowledge-degree" class="label-heading">Degree</label><input id="knowledge-degree" class="form-input" /></div><div><label for="knowledge-department" class="label-heading">Department</label><input id="knowledge-department" class="form-input" /></div><div><label for="knowledge-faculty" class="label-heading">Faculty</label><input id="knowledge-faculty" class="form-input" /></div><div><label for="knowledge-graduation" class="label-heading">Graduation year</label><input id="knowledge-graduation" class="form-input" /></div><div><label for="knowledge-start" class="label-heading">Start date</label><input id="knowledge-start" class="form-input" /></div><div><label for="knowledge-end" class="label-heading">End date</label><input id="knowledge-end" class="form-input" /></div><div><label for="knowledge-thesis" class="label-heading">Thesis title</label><input id="knowledge-thesis" class="form-input" /></div></div><div><label for="knowledge-interests" class="label-heading">Academic interests (one per line)</label><textarea id="knowledge-interests" class="form-input" rows="3"></textarea></div><div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-qualifications" class="label-heading">Other qualifications (one per line)</label><textarea id="knowledge-qualifications" class="form-input" rows="3"></textarea></div><div><label for="knowledge-achievements" class="label-heading">Achievements (one per line)</label><textarea id="knowledge-achievements" class="form-input" rows="3"></textarea></div><div><label for="knowledge-coursework" class="label-heading">Relevant coursework (one per line)</label><textarea id="knowledge-coursework" class="form-input" rows="3"></textarea></div><div><label for="knowledge-research-interests" class="label-heading">Research interests (one per line)</label><textarea id="knowledge-research-interests" class="form-input" rows="3"></textarea></div><div><label for="knowledge-relevant-links" class="label-heading">Relevant links (one per line)</label><textarea id="knowledge-relevant-links" class="form-input" rows="3"></textarea></div></div></div>
                        <div id="knowledge-research-fields" class="knowledge-fields hidden space-y-4 rounded-xl border p-4" data-types="research,research-note"><h4 class="font-bold">Research</h4><div><label for="knowledge-abstract" class="label-heading">Abstract</label><textarea id="knowledge-abstract" rows="4" class="form-input"></textarea></div><div><label for="knowledge-question" class="label-heading">Research question</label><textarea id="knowledge-question" rows="2" class="form-input"></textarea></div><div><label for="knowledge-objectives" class="label-heading">Objectives</label><textarea id="knowledge-objectives" rows="3" class="form-input"></textarea></div><div><label for="knowledge-background" class="label-heading">Background</label><textarea id="knowledge-background" rows="4" class="form-input"></textarea></div><div><label for="knowledge-literature" class="label-heading">Literature review</label><textarea id="knowledge-literature" rows="4" class="form-input"></textarea></div><div><label for="knowledge-methodology" class="label-heading">Methodology</label><textarea id="knowledge-methodology" rows="4" class="form-input"></textarea></div><div><label for="knowledge-materials" class="label-heading">Materials and methods</label><textarea id="knowledge-materials" rows="4" class="form-input"></textarea></div><div><label for="knowledge-findings" class="label-heading">Findings</label><textarea id="knowledge-findings" rows="4" class="form-input"></textarea></div><div><label for="knowledge-discussion" class="label-heading">Discussion</label><textarea id="knowledge-discussion" rows="4" class="form-input"></textarea></div><div><label for="knowledge-conclusion" class="label-heading">Conclusion</label><textarea id="knowledge-conclusion" rows="3" class="form-input"></textarea></div><div><label for="knowledge-references" class="label-heading">References (one citation per line)</label><textarea id="knowledge-references" rows="4" class="form-input"></textarea></div><div><label for="knowledge-doc-file" class="label-heading">Upload research PDF (max 3 MB)</label><input id="knowledge-doc-file" type="file" accept="application/pdf" class="form-input" /></div><div><label for="knowledge-documents" class="label-heading">Document paths / links (one per line)</label><textarea id="knowledge-documents" rows="2" class="form-input"></textarea></div></div>
                        <div id="knowledge-book-fields" class="knowledge-fields hidden space-y-4 rounded-xl border p-4" data-types="book"><h4 class="font-bold">Book notes</h4><div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-book-title" class="label-heading">Book title</label><input id="knowledge-book-title" class="form-input" /></div><div><label for="knowledge-book-author" class="label-heading">Author</label><input id="knowledge-book-author" class="form-input" /></div><div><label for="knowledge-publisher" class="label-heading">Publisher</label><input id="knowledge-publisher" class="form-input" /></div><div><label for="knowledge-edition" class="label-heading">Edition (if known)</label><input id="knowledge-edition" class="form-input" /></div><div><label for="knowledge-reading-status" class="label-heading">Reading status</label><select id="knowledge-reading-status" class="form-input"><option value="want-to-read">Want to read</option><option value="reading">Reading</option><option value="finished">Finished</option><option value="paused">Paused</option></select></div><div><label for="knowledge-reading-start" class="label-heading">Started</label><input id="knowledge-reading-start" type="date" class="form-input" /></div><div><label for="knowledge-reading-end" class="label-heading">Finished</label><input id="knowledge-reading-end" type="date" class="form-input" /></div></div><div><label for="knowledge-concepts" class="label-heading">Important ideas (one per line)</label><textarea id="knowledge-concepts" rows="4" class="form-input"></textarea></div></div>
                        <div id="knowledge-quote-fields" class="knowledge-fields hidden space-y-4 rounded-xl border p-4" data-types="quote"><h4 class="font-bold">Quote attribution</h4><div><label for="knowledge-quote" class="label-heading">Short quote</label><textarea id="knowledge-quote" rows="3" maxlength="500" class="form-input"></textarea><p class="mt-1 text-xs text-slate-500">Keep quotations short, verify attribution, and add your own commentary.</p></div><div class="grid gap-4 sm:grid-cols-2"><div><label for="knowledge-quote-author" class="label-heading">Author</label><input id="knowledge-quote-author" class="form-input" /></div><div><label for="knowledge-quote-source" class="label-heading">Source / book</label><input id="knowledge-quote-source" class="form-input" /></div><div><label for="knowledge-quote-page" class="label-heading">Page / reference</label><input id="knowledge-quote-page" class="form-input" /></div></div><div><label for="knowledge-interpretation" class="label-heading">My interpretation</label><textarea id="knowledge-interpretation" rows="4" class="form-input"></textarea></div></div>
                        <p class="text-xs text-slate-500">Unlisted entries can be opened by anyone with their URL and stay out of site indexes. Private entries are stored in the protected Redis CMS store and never written to this public repository. Moving a private entry to another status explicitly copies it into the public repository.</p>
                        <div><label for="knowledge-body" class="label-heading">Writing / narrative (Markdown)</label><div class="mb-2 flex gap-2"><button id="knowledge-write-tab" type="button" class="btn-secondary px-3 py-2 text-xs">Write</button><button id="knowledge-preview-tab" type="button" class="btn-secondary px-3 py-2 text-xs">Preview</button></div><textarea id="knowledge-body" rows="16" class="form-input font-mono text-sm" placeholder="Write in Markdown. Personal stories, research sections and reading reflections remain distinct from engineering tutorials."></textarea><div id="knowledge-preview" class="markdown-body hidden min-h-48 rounded-xl border bg-white p-5 dark:bg-slate-900"></div></div>
                        <div class="flex flex-wrap gap-2"><button id="knowledge-save-draft" type="button" class="btn-secondary px-4 py-2 text-xs">Save Draft</button><button id="knowledge-publish" type="submit" class="btn-primary px-4 py-2 text-xs">Save & Publish</button><button id="knowledge-delete" type="button" class="hidden rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white">Delete Entry</button></div>
                    </form>
