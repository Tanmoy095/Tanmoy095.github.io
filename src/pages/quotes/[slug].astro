---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
export async function getStaticPaths() { return (await getCollection('knowledge')).filter(e => e.data.type === 'quote' && ['published', 'unlisted'].includes(e.data.status)).map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<MainLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description}>
    <article class="mx-auto max-w-3xl"><a href="/quotes/" class="text-sm font-semibold text-blue-700 dark:text-blue-300">← Quotes & Reflections</a>
        <p class="mt-8 text-sm font-semibold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">{entry.data.category || 'Quote'}{entry.data.status === 'unlisted' && <span class="ml-2 rounded-full bg-amber-100 px-2 py-1 text-amber-800">Unlisted</span>}</p>
        <h1 class="mt-3 text-4xl font-bold md:text-5xl">{entry.data.title}</h1>
        <blockquote class="mt-10 border-l-4 border-blue-600 pl-6 text-2xl leading-relaxed">“{entry.data.quoteText}”<footer class="mt-4 text-base font-semibold">— {entry.data.quoteAuthor}</footer></blockquote>
        <p class="mt-4 text-sm text-slate-500">Source: {entry.data.quoteSource}{entry.data.quotePage && ` · ${entry.data.quotePage}`}</p>
        {entry.data.interpretation && <section class="mt-10"><h2 class="text-xl font-bold">Why it stayed with me</h2><p class="mt-3 whitespace-pre-line leading-7">{entry.data.interpretation}</p></section>}
        {entry.data.takeaways.length > 0 && <ul class="mt-6 list-disc space-y-2 pl-5">{entry.data.takeaways.map(item => <li>{item}</li>)}</ul>}
        <div class="markdown-body mt-10"><Content /></div>
    </article>
</MainLayout>
