---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
const items = (await getCollection('knowledge')).filter(entry => entry.data.status === 'published' && ['essay', 'personal-story', 'reflection'].includes(entry.data.type)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf());
---
<MainLayout title="Writing & Journal" description="Personal essays, observations and reflections by Aunmoy Dey Tanmoy.">
    <header class="mb-12 max-w-3xl"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">Writing & Journal</p><h1 class="mt-3 text-4xl font-bold md:text-6xl">Notes from life beyond code</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">Personal stories, observations, ideas and reflections, kept separate from technical articles.</p></header>
    {items.length ? <div class="grid gap-6 md:grid-cols-2">{items.map(entry => <KnowledgeCard entry={entry} href={`/writing/${entry.id}/`} />)}</div> : <p class="rounded-2xl border border-dashed border-slate-300 p-8 text-slate-500 dark:border-slate-700">No personal writing has been published yet.</p>}
</MainLayout>
